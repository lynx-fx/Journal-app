@page "/settings"
@using JournalApp.Services
@inject IUsersService UsersService
@inject NavigationManager NavManager

<div class="settings-page">
    <div class="header">
         <button class="btn-back" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
            </svg>
        </button>
        <h2>Settings</h2>
        <div style="width: 24px;"></div>
    </div>

    <div class="settings-card">
        <h3>Security</h3>
        <p class="description">Secure your journal with a PIN code.</p>
        
        @if (HasExistingPin)
        {
            <div class="input-group">
                <label>Current PIN</label>
                <input type="password" @bind="CurrentPin" class="pin-input" maxlength="4" placeholder="****" />
            </div>
        }

        <div class="input-group">
            <label>New PIN Code (Numbers only)</label>
            <input type="password" @bind="NewPin" class="pin-input" maxlength="4" placeholder="1234" />
        </div>
        
        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="message @(IsError ? "error" : "success")">@Message</div>
        }

        <button class="btn-primary" @onclick="SavePin">Update PIN</button>
    </div>
</div>

<style>
    .settings-page {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Segoe UI', sans-serif;
    }
    
    .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .btn-back {
        background: transparent;
        border: none;
        color: var(--text-primary);
        cursor: pointer;
        padding: 8px;
        border-radius: 50%;
    }
    
    .btn-back:hover {
        background: var(--input-bg);
    }
    
    .settings-card {
        background: var(--card-bg);
        padding: 24px;
        border-radius: var(--card-radius);
        box-shadow: var(--card-shadow);
    }
    
    h3 { margin-top: 0; margin-bottom: 8px; }
    
    .description {
        color: var(--text-secondary);
        margin-bottom: 20px;
        font-size: 0.95rem;
    }
    
    .input-group {
        margin-bottom: 20px;
    }
    
    .input-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
        font-size: 0.9rem;
    }
    
    .pin-input {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 1.1rem;
        outline: none;
        background: var(--input-bg);
        color: var(--text-primary);
        letter-spacing: 2px;
    }
    
    .pin-input:focus {
        border-color: var(--primary-color);
    }
    
    .btn-primary {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
    }
    
    .message {
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 16px;
        font-size: 0.9rem;
    }
    
    .message.success {
        background: rgba(74, 222, 128, 0.2);
        color: #166534;
    }
    
    .message.error {
        background: rgba(248, 113, 113, 0.2);
        color: #991b1b;
    }
</style>

@code {
    private string CurrentPin { get; set; } = "";
    private string NewPin { get; set; } = "";
    private string Message { get; set; } = "";
    private bool IsError { get; set; } = false;
    private bool HasExistingPin { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        HasExistingPin = await UsersService.HasPinAsync();
    }

    private async Task SavePin()
    {
        Message = "";
        IsError = false;

        if (HasExistingPin)
        {
            if (string.IsNullOrEmpty(CurrentPin))
            {
                 Message = "Please enter your current PIN.";
                 IsError = true;
                 return;
            }
            
            var isValid = await UsersService.ValidatePinAsync(CurrentPin);
            if (!isValid)
            {
                 Message = "Current PIN is incorrect.";
                 IsError = true;
                 return;
            }
        }

        if (string.IsNullOrWhiteSpace(NewPin) || !int.TryParse(NewPin, out _))
        {
            Message = "Please enter a valid numeric PIN.";
            IsError = true;
            return;
        }

        if (NewPin.Length < 4)
        {
             Message = "PIN must be at least 4 digits.";
             IsError = true;
             return;
        }

        await UsersService.SavePinAsync(NewPin);
        
        Message = "PIN updated successfully!";
        NewPin = "";
        CurrentPin = "";
        HasExistingPin = true; // Now they surely have one
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/calendar");
    }
}
